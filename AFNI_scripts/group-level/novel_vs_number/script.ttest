#!/bin/tcsh -xef

# created by uber_ttest.py: version 2.0 (December 28, 2017)
# creation date: Tue Oct 28 15:35:58 2025

# ---------------------- set process variables ----------------------

set mask_dset = /labs/koutstaal/Semantic_Cognition/semantic_root/j_triads_univ/j_triads_group/stats/pcb/group_80%_mask+tlrc

set dirA = /labs/koutstaal/Semantic_Cognition/semantic_root/j_triads_univ/pcb/subject_results/averaged

# specify and possibly create results directory
set results_dir = test.results
if ( ! -d $results_dir ) mkdir $results_dir

# ------------------------- process the data -------------------------

3dttest++ -prefix $results_dir/stats.ttest -AminusB -paired \
          -mask $mask_dset                                  \
          -clustsim                                         \
          -setA novel                                       \
             01 "$dirA/tp101_novel+tlrc[0]"                 \
