             14 "$dirA/tp114_novel+tlrc[0]"                 \
             15 "$dirA/tp115_novel+tlrc[0]"                 \
             16 "$dirA/tp116_novel+tlrc[0]"                 \
             17 "$dirA/tp117_novel+tlrc[0]"                 \
             18 "$dirA/tp118_novel+tlrc[0]"                 \
